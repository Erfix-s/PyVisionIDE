diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 19894b5..70c9306 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -21,6 +21,8 @@ concurrency:
 env:
   # Strictly increasing -> versionCode and versionName (1.0.<run number>)
   PYSTUDIO_RUN_NUMBER: ${{ github.run_number }}
+  PYSTUDIO_BUILD_NUMBER: ${{ github.run_number }}
+  PYSTUDIO_VERSION_NAME: 1.0.${{ github.run_number }}
   GRADLE_OPTS: "-Dorg.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8"
 
 jobs:
@@ -90,7 +92,40 @@ jobs:
         working-directory: ${{ steps.unzip.outputs.dir }}
         run: |
           set -euo pipefail
-          keytool -list -keystore app/pystudio-release.keystore -storepass pystudio-release -alias pystudio | tail -n 3
+          PROPERTIES="keystore.properties"
+          if [[ ! -f "$PROPERTIES" ]]; then
+            echo "::error::keystore.properties not found."
+            exit 1
+          fi
+
+          property() {
+            awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$PROPERTIES"
+          }
+
+          STORE_FILE="$(property storeFile)"
+          STORE_TYPE="$(property storeType)"
+          STORE_PASSWORD="$(property storePassword)"
+          KEY_ALIAS="$(property keyAlias)"
+
+          if [[ -z "$STORE_FILE" || -z "$STORE_PASSWORD" || -z "$KEY_ALIAS" ]]; then
+            echo "::error::Signing configuration is incomplete in keystore.properties."
+            exit 1
+          fi
+          if [[ ! -f "$STORE_FILE" ]]; then
+            echo "::error::Signing keystore not found: $STORE_FILE"
+            exit 1
+          fi
+
+          export KEYSTORE_PASSWORD="$STORE_PASSWORD"
+          if ! keytool -list \
+            -keystore "$STORE_FILE" \
+            -storetype "${STORE_TYPE:-PKCS12}" \
+            -storepass:env KEYSTORE_PASSWORD \
+            -alias "$KEY_ALIAS" >/dev/null; then
+            echo "::error::Could not verify signing key from keystore.properties."
+            exit 1
+          fi
+          echo "Verified signing key: $STORE_FILE ($KEY_ALIAS)"
 
       - name: Build and sign release APK
         shell: bash
